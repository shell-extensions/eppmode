#!/bin/sh
# Root helper for EPP Power Modes. Installed to /usr/local/bin/eppmode-helper
# and invoked via passwordless sudo from the GNOME Shell extension.
set -eu

STATE_DIR=/var/lib/eppmode
STATE_FILE="$STATE_DIR/state"
LOCK_FILE="$STATE_DIR/.lock"
PLATFORM_WRITE_FILE="$STATE_DIR/.platform-write"

require_root() {
	if [ "$(id -u)" -ne 0 ]; then
		echo "This helper must be run as root (via sudo)." >&2
		exit 1
	fi
}

usage() {
	cat <<'EOF'
Usage: eppmode-helper <command> [args]

Commands:
  set <state>      Apply one of the four fixed modes immediately.
  lock             Block automatic (drift) changes.
  unlock           Allow automatic changes again.
  reassert         Re-apply APPLIED if locked; otherwise adopt hardware drift.
  battery-check    Read UPower and enforce/lift the battery safety net.
  restore          Apply APPLIED to hardware (boot restore).
  status           Print the state file.
EOF
}

# Same word-membership helper as power-saver-epp-fix/src/ppd-epp-override.
has_word() {
	case " $1 " in
		*" $2 "*) return 0 ;;
		*) return 1 ;;
	esac
}

report_error() {
	printf '%s\n' "$1" >&2
	logger -t eppmode "$1" || true
}

mode_epp() {
	case "$1" in
		power-saver) printf '%s\n' power ;;
		balanced-powersave) printf '%s\n' balance_power ;;
		balanced-performance) printf '%s\n' balance_performance ;;
		performance) printf '%s\n' performance ;;
	esac
}

mode_platform_profile() {
	case "$1" in
		power-saver|balanced-powersave) printf '%s\n' low-power ;;
		balanced-performance) printf '%s\n' balanced ;;
		performance) printf '%s\n' performance ;;
	esac
}

mode_ppd_profile() {
	case "$1" in
		power-saver) printf '%s\n' power-saver ;;
		balanced-powersave|balanced-performance) printf '%s\n' balanced ;;
		performance) printf '%s\n' performance ;;
	esac
}

mode_is_valid() {
	case "$1" in
		power-saver|balanced-powersave|balanced-performance|performance) return 0 ;;
		*) return 1 ;;
	esac
}

sync_power_profiles_daemon() {
	if ! command -v systemctl >/dev/null 2>&1 ||
		! systemctl is-active --quiet power-profiles-daemon.service 2>/dev/null; then
		return 0
	fi
	if ! command -v powerprofilesctl >/dev/null 2>&1; then
		report_error "power-profiles-daemon is active but powerprofilesctl is unavailable"
		return 1
	fi

	target_profile="$(mode_ppd_profile "$1")"
	current_profile="$(powerprofilesctl get 2>/dev/null || true)"
	if [ "$current_profile" = "$target_profile" ]; then
		return 0
	fi
	if ! powerprofilesctl set "$target_profile" >/dev/null 2>&1; then
		report_error "Failed to synchronize power-profiles-daemon to $target_profile"
		return 1
	fi

	# PPD applies its CPU driver asynchronously. Match the proven guard order
	# from power-saver-epp-fix before refining its three profiles to four EPPs.
	sleep "${EPPMODE_PPD_DELAY:-0.2}"
}

apply_epp() {
	target_epp="$(mode_epp "$1")"
	found=0
	failed=0

	available_file=
	for f in /sys/devices/system/cpu/cpu[0-9]*/cpufreq/energy_performance_available_preferences \
		/sys/devices/system/cpu/cpu[0-9]*/cpufreq/available_energy_performance_preferences; do
		if [ -r "$f" ]; then
			available_file="$f"
			break
		fi
	done

	if [ -n "$available_file" ]; then
		available="$(cat "$available_file")"
		if ! has_word "$available" "$target_epp"; then
			report_error "EPP preference '$target_epp' is not available: $available"
			return 1
		fi
	fi

	for f in /sys/devices/system/cpu/cpu[0-9]*/cpufreq/energy_performance_preference; do
		[ -e "$f" ] || continue
		found=1
		current="$(cat "$f" 2>/dev/null || true)"
		if [ "$current" != "$target_epp" ]; then
			if ! printf '%s\n' "$target_epp" > "$f" 2>/dev/null; then
				report_error "Failed to set $f to $target_epp"
				failed=1
				continue
			fi
		fi
		current="$(cat "$f" 2>/dev/null || true)"
		if [ "$current" != "$target_epp" ]; then
			report_error "Failed to verify $f after setting it to $target_epp"
			failed=1
		fi
	done

	if [ "$found" -eq 0 ]; then
		report_error "No CPU EPP control files were found"
		return 1
	fi
	[ "$failed" -eq 0 ]
}

platform_profile_files() {
	found=0
	for profile_file in /sys/class/platform-profile/platform-profile-*/profile; do
		[ -e "$profile_file" ] || continue
		found=1
		printf '%s\n' "$profile_file"
	done

	if [ "$found" -eq 0 ] && [ -e /sys/firmware/acpi/platform_profile ]; then
		printf '%s\n' /sys/firmware/acpi/platform_profile
	fi
}

platform_profile_choices_file() {
	case "$1" in
		/sys/class/platform-profile/*/profile)
			printf '%s\n' "${1%/profile}/choices"
			;;
		/sys/firmware/acpi/platform_profile)
			printf '%s\n' /sys/firmware/acpi/platform_profile_choices
			;;
	esac
}

platform_profiles_support() (
	target_platform="$1"
	profile_files="$2"

	for profile_file in $profile_files; do
		choices_file="$(platform_profile_choices_file "$profile_file")"
		[ -r "$choices_file" ] || continue
		choices="$(cat "$choices_file" 2>/dev/null || true)"
		has_word "$choices" "$target_platform" && exit 0
	done
	exit 1
)

platform_profiles_match() (
	target_platform="$1"
	profile_files="$2"
	supported=0

	for profile_file in $profile_files; do
		choices_file="$(platform_profile_choices_file "$profile_file")"
		[ -r "$choices_file" ] || continue
		choices="$(cat "$choices_file" 2>/dev/null || true)"
		has_word "$choices" "$target_platform" || continue
		supported=1
		current_platform="$(cat "$profile_file" 2>/dev/null || true)"
		[ "$current_platform" = "$target_platform" ] || exit 1
	done
	[ "$supported" -eq 1 ]
)

platform_profile_summary() (
	profile_files="$1"
	separator=

	for profile_file in $profile_files; do
		profile_name="$(cat "${profile_file%/profile}/name" 2>/dev/null ||
			printf '%s' "$profile_file")"
		current_platform="$(cat "$profile_file" 2>/dev/null || printf unreadable)"
		printf '%s%s=%s' "$separator" "$profile_name" "$current_platform"
		separator=', '
	done
)

# One-line "provider=value, ..." summary for pending/diagnostic messages.
describe_platform_state() {
	files="$(platform_profile_files)"
	[ -n "$files" ] || return 0
	platform_profile_summary "$files"
}

write_direct_platform_profiles() {
	target_platform="$1"
	profile_files="$2"
	supported=0
	failed=0

	for profile_file in $profile_files; do
		choices_file="$(platform_profile_choices_file "$profile_file")"
		[ -r "$choices_file" ] || continue
		choices="$(cat "$choices_file" 2>/dev/null || true)"
		has_word "$choices" "$target_platform" || continue
		supported=1

		if [ ! -w "$profile_file" ]; then
			report_error "$profile_file exists but is not writable"
			failed=1
			continue
		fi
		if ! printf '%s\n' "$target_platform" > "$profile_file" 2>/dev/null; then
			report_error "Failed to set $profile_file to $target_platform"
			failed=1
		fi
	done

	[ "$supported" -eq 1 ] && [ "$failed" -eq 0 ]
}

write_aggregate_platform_profile() {
	target_platform="$1"
	legacy_profile=/sys/firmware/acpi/platform_profile
	legacy_choices=/sys/firmware/acpi/platform_profile_choices

	[ -w "$legacy_profile" ] && [ -r "$legacy_choices" ] || return 1
	choices="$(cat "$legacy_choices" 2>/dev/null || true)"
	has_word "$choices" "$target_platform" || return 1
	printf '%s\n' "$target_platform" > "$legacy_profile" 2>/dev/null
}

# Have we already tried writing this same target within the cooldown
# window? DYTC either accepts a write within well under a second or not at
# all (see docs/power-saver-platform-profile-diagnose.de.md); repeating the
# same write more often than EPPMODE_PLATFORM_MIN_INTERVAL just hammers the
# firmware without changing the outcome.
platform_write_on_cooldown() {
	target_platform="$1"
	[ -r "$PLATFORM_WRITE_FILE" ] || return 1
	stored_uptime=
	stored_target=
	read -r stored_uptime stored_target < "$PLATFORM_WRITE_FILE" 2>/dev/null || return 1
	[ "$stored_target" = "$target_platform" ] || return 1
	case "$stored_uptime" in
		""|*[!0-9.]*) return 1 ;;
	esac
	now="$(awk '{print $1}' /proc/uptime 2>/dev/null || printf 0)"
	# A stored uptime greater than the current one means the machine
	# rebooted since; treat that as an expired cooldown, not an active one.
	awk -v s="$stored_uptime" -v n="$now" -v m="${EPPMODE_PLATFORM_MIN_INTERVAL:-30}" \
		'BEGIN { exit !(s <= n && (n - s) < m) }'
}

record_platform_write() {
	mkdir -p "$STATE_DIR" 2>/dev/null || true
	now="$(awk '{print $1}' /proc/uptime 2>/dev/null || printf 0)"
	printf '%s %s\n' "$now" "$1" > "$PLATFORM_WRITE_FILE" 2>/dev/null || true
}

# Returns 0 (fully applied), 1 (hard failure: bad config, no writable
# profile file), or 2 (the write was sent but not confirmed stable within
# the timeout, or was skipped because of the cooldown above; the caller is
# expected to record the target as pending and let the next reassert retry
# it). $2 = "force" bypasses the cooldown check (used for direct user
# actions and boot restore, never for the periodic reassert).
apply_platform_profile() {
	target_platform="$(mode_platform_profile "$1")"
	force="${2:-}"
	profile_files="$(platform_profile_files)"
	[ -n "$profile_files" ] || return 0

	platform_profiles_support "$target_platform" "$profile_files" || return 0
	platform_profiles_match "$target_platform" "$profile_files" && return 0

	if [ "$force" != "force" ] && platform_write_on_cooldown "$target_platform"; then
		return 2
	fi

	poll_delay="${EPPMODE_PLATFORM_POLL_DELAY:-${EPPMODE_PLATFORM_DELAY:-0.25}}"
	max_polls="${EPPMODE_PLATFORM_MAX_POLLS:-6}"
	stable_reads_required="${EPPMODE_PLATFORM_STABLE_READS:-2}"
	retry_every="${EPPMODE_PLATFORM_RETRY_EVERY:-4}"
	max_writes="${EPPMODE_PLATFORM_MAX_WRITES:-1}"
	for retry_value in "$max_polls" "$stable_reads_required" "$retry_every" "$max_writes"; do
		case "$retry_value" in
			""|*[!0-9]*) report_error "Invalid platform_profile retry configuration"; return 1 ;;
		esac
	done
	if [ "$max_polls" -eq 0 ] ||
		[ "$stable_reads_required" -eq 0 ] ||
		[ "$retry_every" -eq 0 ] ||
		[ "$max_writes" -eq 0 ]; then
		report_error "Invalid platform_profile retry configuration"
		return 1
	fi

	record_platform_write "$target_platform"

	# Use one route for the whole transaction. Repeatedly alternating between
	# the aggregate and provider files queues competing ThinkPad DYTC completion
	# events. Provider class files remain authoritative for verification.
	write_route=direct
	case "$profile_files" in
		*/sys/class/platform-profile/*)
			if write_aggregate_platform_profile "$target_platform"; then
				write_route=aggregate
			elif ! write_direct_platform_profiles "$target_platform" "$profile_files"; then
				return 1
			fi
			;;
		*)
			write_direct_platform_profiles "$target_platform" "$profile_files" || return 1
			;;
	esac
	writes=1
	stable_reads=0
	poll=1
	while [ "$poll" -le "$max_polls" ]; do
		sleep "$poll_delay"
		if platform_profiles_match "$target_platform" "$profile_files"; then
			stable_reads=$((stable_reads + 1))
			[ "$stable_reads" -lt "$stable_reads_required" ] || return 0
		else
			stable_reads=0
			if [ $((poll % retry_every)) -eq 0 ] && [ "$writes" -lt "$max_writes" ]; then
				if [ "$write_route" = aggregate ]; then
					if ! write_aggregate_platform_profile "$target_platform"; then
						write_route=direct
						write_direct_platform_profiles "$target_platform" "$profile_files" ||
							return 1
					fi
				else
					write_direct_platform_profiles "$target_platform" "$profile_files" ||
						return 1
				fi
				writes=$((writes + 1))
			fi
		fi
		poll=$((poll + 1))
	done

	return 2
}

apply_hardware() {
	sync_power_profiles_daemon "$1" || return 1
	apply_epp "$1" || return 1
	apply_platform_profile "$1" "${2:-}"
}

read_epp_mode() {
	found=0
	actual_epp=
	for f in /sys/devices/system/cpu/cpu[0-9]*/cpufreq/energy_performance_preference; do
		[ -r "$f" ] || continue
		current="$(cat "$f" 2>/dev/null)" || return 1
		if [ "$found" -eq 1 ] && [ "$current" != "$actual_epp" ]; then
			return 1
		fi
		found=1
		actual_epp="$current"
	done
	[ "$found" -eq 1 ] || return 1

	case "$actual_epp" in
		power) printf '%s\n' power-saver ;;
		balance_power) printf '%s\n' balanced-powersave ;;
		balance_performance) printf '%s\n' balanced-performance ;;
		performance) printf '%s\n' performance ;;
		*) return 1 ;;
	esac
}

read_platform_profile() {
	profile_files="$(platform_profile_files)"
	[ -n "$profile_files" ] || return 0

	found=0
	actual_platform=
	for profile_file in $profile_files; do
		[ -r "$profile_file" ] || continue
		current_platform="$(cat "$profile_file" 2>/dev/null)" || return 1
		if [ "$found" -eq 1 ] && [ "$current_platform" != "$actual_platform" ]; then
			return 1
		fi
		found=1
		actual_platform="$current_platform"
	done
	[ "$found" -eq 1 ] || return 0
	printf '%s\n' "$actual_platform"
}

hardware_matches_mode() {
	expected_mode="$1"
	actual_epp_mode="$(read_epp_mode 2>/dev/null || true)"
	[ "$actual_epp_mode" = "$expected_mode" ] || return 1

	if ! actual_platform="$(read_platform_profile)"; then
		return 1
	fi
	expected_platform="$(mode_platform_profile "$expected_mode")"
	[ -z "$actual_platform" ] || [ "$actual_platform" = "$expected_platform" ]
}

mode_for_unlocked_hardware() {
	epp_mode="$1"
	platform_profile="$2"

	case "$platform_profile" in
		low-power)
			case "$epp_mode" in
				power-saver|balanced-powersave) printf '%s\n' "$epp_mode" ;;
				*) printf '%s\n' power-saver ;;
			esac
			;;
		performance) printf '%s\n' performance ;;
		balanced) printf '%s\n' balanced-performance ;;
		"") [ -n "$epp_mode" ] && printf '%s\n' "$epp_mode" || return 1 ;;
		*) return 1 ;;
	esac
}

read_state_value() {
	key="$1"
	[ -r "$STATE_FILE" ] || return 0
	while IFS='=' read -r k v; do
		[ "$k" = "$key" ] && printf '%s\n' "$v"
	done < "$STATE_FILE"
	return 0
}

write_state() {
	# $1=SELECTED $2=APPLIED $3=LOCK $4=SAFETY $5=PLATFORM_PENDING
	tmp="$(mktemp "$STATE_DIR/.state.XXXXXX")"
	cat > "$tmp" <<EOF
SELECTED=$1
APPLIED=$2
LOCK=$3
SAFETY=$4
PLATFORM_PENDING=$5
EOF
	chmod 0644 "$tmp"
	mv -f "$tmp" "$STATE_FILE"
}

current_or_default() {
	key="$1"
	default="$2"
	value="$(read_state_value "$key")"
	[ -n "$value" ] && printf '%s\n' "$value" || printf '%s\n' "$default"
}

with_lock() {
	mkdir -p "$STATE_DIR"
	exec 9>"$LOCK_FILE"
	flock 9
	"$@"
}

# Applies $1 (forced, bypassing the platform_profile cooldown) and records
# the outcome. $2=SELECTED to record, $1 doubles as the value recorded for
# APPLIED since every caller applies exactly what it wants applied. $3=LOCK
# $4=SAFETY. A hard failure (rc 1) is left for the caller to react to; a
# platform_profile timeout (rc 2) is recorded as pending, not treated as a
# failure, since EPP and power-profiles-daemon are already correct.
apply_hardware_and_write() {
	rc=0
	apply_hardware "$1" force || rc=$?
	[ "$rc" -eq 1 ] && return 1
	if [ "$rc" -eq 2 ]; then
		write_state "$2" "$1" "$3" "$4" "$(mode_platform_profile "$1")"
		report_error "Platform profile for $1 is pending ($(describe_platform_state))"
	else
		write_state "$2" "$1" "$3" "$4" ""
	fi
	return 0
}

cmd_set() {
	target="$1"
	mode_is_valid "$target" || { echo "Unknown mode: $target" >&2; exit 1; }
	lock="$(current_or_default LOCK 0)"
	apply_hardware_and_write "$target" "$target" "$lock" 0
}

cmd_lock() {
	selected="$(current_or_default SELECTED balanced-performance)"
	applied="$(current_or_default APPLIED balanced-performance)"
	safety="$(current_or_default SAFETY 0)"
	pending="$(current_or_default PLATFORM_PENDING "")"
	write_state "$selected" "$applied" 1 "$safety" "$pending"
}

cmd_unlock() {
	selected="$(current_or_default SELECTED balanced-performance)"
	applied="$(current_or_default APPLIED balanced-performance)"
	safety="$(current_or_default SAFETY 0)"
	pending="$(current_or_default PLATFORM_PENDING "")"
	write_state "$selected" "$applied" 0 "$safety" "$pending"
}

cmd_reassert() {
	lock="$(current_or_default LOCK 0)"
	applied="$(current_or_default APPLIED balanced-performance)"
	selected="$(current_or_default SELECTED "$applied")"
	safety="$(current_or_default SAFETY 0)"
	pending="$(current_or_default PLATFORM_PENDING "")"

	if [ "$lock" = "1" ] || [ "$safety" = "1" ]; then
		if hardware_matches_mode "$applied"; then
			if [ -n "$pending" ]; then
				write_state "$selected" "$applied" "$lock" "$safety" ""
				logger -t eppmode "eppmode: platform_profile pending resolved for $applied" || true
			fi
			return 0
		fi

		rc=0
		apply_hardware "$applied" || rc=$?

		if [ "$rc" -eq 0 ]; then
			if [ -n "$pending" ]; then
				write_state "$selected" "$applied" "$lock" "$safety" ""
				logger -t eppmode "eppmode: platform_profile pending resolved for $applied" || true
			fi
			return 0
		fi

		if [ "$rc" -eq 2 ]; then
			target_platform="$(mode_platform_profile "$applied")"
			if [ "$pending" != "$target_platform" ]; then
				write_state "$selected" "$applied" "$lock" "$safety" "$target_platform"
				report_error "Platform profile for $applied is pending ($(describe_platform_state))"
			fi
			return 0
		fi

		if [ "$lock" = "1" ]; then
			write_state "$selected" "$applied" 0 "$safety" "$pending"
			report_error "Lock disabled because the applied power mode could not be enforced"
		else
			report_error "Battery safety power mode could not be enforced"
		fi
		return 1
	fi

	epp_mode="$(read_epp_mode 2>/dev/null || true)"
	expected_platform="$(mode_platform_profile "$applied")"

	# A platform_profile write we ourselves started but that DYTC hasn't
	# confirmed yet is not foreign drift: EPP already matches APPLIED, and
	# the outstanding profile is exactly the one APPLIED wants. Keep
	# retrying towards APPLIED instead of reinterpreting this as an
	# external mode change.
	if [ -n "$pending" ] && [ "$pending" = "$expected_platform" ] && [ "$epp_mode" = "$applied" ]; then
		if hardware_matches_mode "$applied"; then
			write_state "$selected" "$applied" 0 "$safety" ""
			logger -t eppmode "eppmode: platform_profile pending resolved for $applied" || true
			return 0
		fi
		rc=0
		apply_hardware "$applied" || rc=$?
		if [ "$rc" -eq 0 ]; then
			write_state "$selected" "$applied" 0 "$safety" ""
			logger -t eppmode "eppmode: platform_profile pending resolved for $applied" || true
		elif [ "$rc" -eq 1 ]; then
			report_error "Could not re-apply $applied while a platform profile change was pending"
		fi
		return 0
	fi

	if ! platform_profile="$(read_platform_profile)"; then
		report_error "Could not read platform_profile while reconciling unlocked hardware state"
		return 1
	fi
	target="$(mode_for_unlocked_hardware "$epp_mode" "$platform_profile" 2>/dev/null || true)"
	if [ -z "$target" ]; then
		report_error "Could not reconcile unlocked hardware state"
		return 1
	fi

	if [ "$epp_mode" = "$applied" ] &&
		{ [ -z "$platform_profile" ] || [ "$platform_profile" = "$expected_platform" ]; }; then
		return
	fi

	rc=0
	apply_hardware "$target" || rc=$?
	[ "$rc" -eq 1 ] && return 1
	if [ "$rc" -eq 2 ]; then
		write_state "$target" "$target" 0 0 "$(mode_platform_profile "$target")"
	else
		write_state "$target" "$target" 0 0 ""
	fi
}

# UPower state values: 1=charging, 2=discharging, 3=empty,
# 4=fully-charged, 5=pending-charge, 6=pending-discharge.
cmd_battery_check() {
	percent="${FAKE_PERCENT:-}"
	state="${FAKE_STATE:-}"

	if [ -z "$percent" ] && [ -z "$state" ]; then
		if ! reply="$(gdbus call --system \
			--dest org.freedesktop.UPower \
			--object-path /org/freedesktop/UPower/devices/DisplayDevice \
			--method org.freedesktop.DBus.Properties.GetAll \
			org.freedesktop.UPower.Device 2>/dev/null)"; then
			report_error "Could not read battery data from UPower"
			return 1
		fi
		percent="$(printf '%s\n' "$reply" |
			sed -n "s/.*'Percentage': <\([0-9][0-9.]*\)>.*/\1/p")"
		state_num="$(printf '%s\n' "$reply" |
			sed -n "s/.*'State': <uint32 \([0-9][0-9]*\)>.*/\1/p")"
		case "$state_num" in
			2|3|6) state=discharging ;;
			1|4|5) state=external-power ;;
			*)
				report_error "UPower returned an unknown or missing battery state"
				return 1
				;;
		esac
	elif [ -z "$percent" ] || [ -z "$state" ]; then
		report_error "FAKE_PERCENT and FAKE_STATE must be set together"
		return 1
	else
		case "$state" in
			discharging) ;;
			charging|external-power) state=external-power ;;
			*)
				report_error "Unknown FAKE_STATE: $state"
				return 1
				;;
		esac
	fi

	if ! awk -v p="$percent" \
		'BEGIN { exit !(p ~ /^[0-9]+([.][0-9]+)?$/ && p >= 0 && p <= 100) }'; then
		report_error "Invalid battery percentage: $percent"
		return 1
	fi

	selected="$(current_or_default SELECTED balanced-performance)"
	applied="$(current_or_default APPLIED balanced-performance)"
	lock="$(current_or_default LOCK 0)"
	safety="$(current_or_default SAFETY 0)"

	is_below="$(awk -v p="$percent" 'BEGIN { print (p < 20) ? 1 : 0 }')"
	is_above="$(awk -v p="$percent" 'BEGIN { print (p >= 25) ? 1 : 0 }')"

	if [ "$state" = "discharging" ] && [ "$is_below" = "1" ]; then
		if [ "$selected" = "power-saver" ]; then
			if [ "$applied" != "power-saver" ] || [ "$safety" != "0" ]; then
				apply_hardware_and_write power-saver "$selected" "$lock" 0
			fi
		elif [ "$safety" != "1" ]; then
			apply_hardware_and_write balanced-powersave "$selected" "$lock" 1
		fi
	elif { [ "$state" = "external-power" ] || [ "$is_above" = "1" ]; } && [ "$safety" = "1" ]; then
		apply_hardware_and_write "$selected" "$selected" "$lock" 0
	fi
}

cmd_restore() {
	mkdir -p "$STATE_DIR"
	applied="$(current_or_default APPLIED balanced-performance)"
	selected="$(current_or_default SELECTED "$applied")"
	lock="$(current_or_default LOCK 0)"
	safety="$(current_or_default SAFETY 0)"
	rc=0
	apply_hardware "$applied" force || rc=$?
	[ "$rc" -eq 1 ] && return 1
	if [ ! -f "$STATE_FILE" ]; then
		if [ "$rc" -eq 2 ]; then
			write_state "$selected" "$applied" "$lock" "$safety" "$(mode_platform_profile "$applied")"
		else
			write_state "$selected" "$applied" "$lock" "$safety" ""
		fi
	fi
}

cmd_status() {
	[ -r "$STATE_FILE" ] && cat "$STATE_FILE" || echo "(no state file yet)"
}

require_root

[ "$#" -ge 1 ] || { usage >&2; exit 1; }
command="$1"
shift

case "$command" in
	set)
		[ "$#" -eq 1 ] || { usage >&2; exit 1; }
		with_lock cmd_set "$1"
		;;
	lock) with_lock cmd_lock ;;
	unlock) with_lock cmd_unlock ;;
	reassert) with_lock cmd_reassert ;;
	battery-check) with_lock cmd_battery_check ;;
	restore) with_lock cmd_restore ;;
	status) cmd_status ;;
	-h|--help) usage ;;
	*) echo "Unknown command: $command" >&2; usage >&2; exit 1 ;;
esac
